{
  "name": "confluence-to-git",
  "version": "0.1.0",
  "description": "Convert an entire Confluence Cloud instance to a local git repository, preserving content, metadata, history, comments, and attachments.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "confluence-to-git": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/confluence-to-git",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
